{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tide",
  "version": "0.1.0",
  "identifier": "dev.tide.app",
  "build": {
    "frontendDist": "../dist/webview",
    "beforeBuildCommand": "bun run build:webview && bun run build:exe"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tide",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "url": "http://127.0.0.1:5733"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../dist/tide.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
